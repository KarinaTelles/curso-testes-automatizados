<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>curso</groupId>
  <artifactId>curso-testes-automatizados</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Curso de testes automatizados</name>
  <description>Módulos em Java do curso: POO, JUnit, Cucumber e Selenium</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <junit.version>6.1.3</junit.version>
    <cucumber.version>8.0.4</cucumber.version>
    <selenium.version>4.52.0</selenium.version>
    <jackson.version>3.3.0</jackson.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
  </properties>

  <!--
    Por padrão o build roda só os gabaritos (é o que a CI executa).
    Para rodar os exercícios:  ./mvnw test -P exercicios
  -->
  <profiles>
    <profile>
      <id>gabarito</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>03-poo-e-testes-java/gabarito</module>
        <module>04-bdd-com-cucumber/gabarito</module>
        <module>05-testes-de-interface-selenium/gabarito</module>
      </modules>
    </profile>
    <profile>
      <id>exercicios</id>
      <modules>
        <module>03-poo-e-testes-java/exercicios</module>
        <module>04-bdd-com-cucumber/exercicios</module>
        <module>05-testes-de-interface-selenium/exercicios</module>
      </modules>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.seleniumhq.selenium</groupId>
        <artifactId>selenium-java</artifactId>
        <version>${selenium.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
